# ==============================================================================
# Reel Vault — Environment Configuration
# ==============================================================================

# Server & Environment
ENVIRONMENT=development                # development | production
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Authentication (Single-user vault access token / password)
VAULT_AUTH_TOKEN=your_secure_vault_access_token_here

# Pipeline Control
ENABLE_REAL_PIPELINE=true             # Set true to use live ingestion and Gemini API
ALLOW_MOCK=false                      # Fail startup if real pipeline is disabled in production
ANALYZE_POSTS=false                   # Set false to save /p/ and /tv/ posts as instant manual notes
ENABLE_SERVER_YTDLP_EXPERIMENT=true   # Allows server-side downloading via yt-dlp/gallery-dl

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MULTIMODAL_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Processing & Storage
DAILY_PROCESSING_CAP=50
SQLITE_DB_FILE=./spike_data/vault.db
SPIKE_DATA_DIR=./spike_data
TEMP_MEDIA_DIR=./spike_data/temp_media

# Optional: Instagram Cookies (Never commit cookie files)
COOKIES_FILE=
